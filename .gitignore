# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environments and local settings
.env
.venv/
env/
venv/
secrets.json
config_local.py

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Downloaded or derived market data: fetched on demand, never committed
data/raw/
data/processed/
data/backtest/
data/mining/intraday_cache/
data/mining/universe_cache/
data/mining/panel/cache_*/
data/mining/*.lock
data/raw_backup_*/

# Run outputs: regenerated by the scripts, carry local settings or vendor
# values, and are not part of the published source
data/mining/trial_ledger.jsonl
data/mining/capex_watchlist_*.json
data/mining/retail_inventory_coverage_*.json
data/mining/accrual_coverage_*.json
data/mining/panel/snapshots/
data/mining/batch5_events/
data/mining/gold_copper/*.csv
data/mining/swing_earnings_events.json
data/mining/xrt_holdings_*.json
research/**/raw/
research/**/artifacts/
runs/

# data/live holds run-time files. Only the pinned exchange calendar is tracked.
# Git cannot re-include a file inside an excluded folder, so un-ignore the folder,
# ignore its contents, then re-include the one file by name.
!data/live/
data/live/*
!data/live/nyse_calendar_2026_2028.json

# Sweep and chart outputs
outputs/
